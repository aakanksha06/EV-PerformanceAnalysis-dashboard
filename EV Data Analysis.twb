      <column caption='% of BEV Vehicles' datatype='real' name='[Calculation_1161148860141571]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1161148859273218]/ [Calculation_1161148856705024]' />
      </column>
      <column caption='Total PHEV Vehicles' datatype='integer' name='[Calculation_1161148860862468]' role='measure' type='quantitative'>
